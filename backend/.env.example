# Render / production database settings
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=ridesnap

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Optional frontend origin. Leave empty for local development.
FRONTEND_URL=http://localhost:3000

# Ride pricing
BASE_FARE=500
PER_UNIT_FARE=1.75
FARE_UNIT=km
CURRENCY_SYMBOL=₹
DRIVER_ALLOWANCE=250
